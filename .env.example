# Vercel server-only settings. Never commit real values.
DATABASE_URL=
CRON_SECRET=
ODDS_API_KEY=
BOATBOYZ_PIN=
# Safe launch defaults: scan/grade normally; simulate new auto tickets.
BOATBOYZ_LIVE_POSTING=false
PAPER_MODE=true
FREE_BETA_MODE=true
# Initial default; a saved operator target takes precedence (1-6).
DAILY_PICK_TARGET=3
# Create these in separate Discord channels.
DISCORD_PICKS_WEBHOOK=
DISCORD_RESULTS_WEBHOOK=
DISCORD_ALERT_WEBHOOK=
DISCORD_TEST_WEBHOOK=
# Optional; falls back to test-lab, never official-picks.
DISCORD_MANUAL_WEBHOOK=
# Legacy picks-only fallback. Prefer DISCORD_PICKS_WEBHOOK.
DISCORD_WEBHOOK_URL=
# GitHub Actions secrets: APP_URL and CRON_SECRET (same as Vercel).
# APP_URL=https://your-app.vercel.app
