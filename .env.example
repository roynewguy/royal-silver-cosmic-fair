# Vercel server-only settings. Never commit real values.
DATABASE_URL=
CRON_SECRET=
ODDS_API_KEY=
BOATBOYZ_PIN=
# Safe launch defaults: scan/grade normally; simulate new auto tickets.
BOATBOYZ_LIVE_POSTING=false
PAPER_MODE=true
FREE_BETA_MODE=true
# Initial default; a saved operator target takes precedence (1-6).
DAILY_PICK_TARGET=3
# Max 1 free #free-picks post per PT day (0 disables). VIP target above is unchanged.
DAILY_FREE_PICK_TARGET=1
# Create these in separate Discord channels.
DISCORD_PICKS_WEBHOOK=
# Public #free-picks (max 1/PT day LOCK-or-DESK). Never shares VIP picks webhook.
DISCORD_FREE_PICKS_WEBHOOK=
DISCORD_RESULTS_WEBHOOK=
DISCORD_ALERT_WEBHOOK=
DISCORD_TEST_WEBHOOK=
# Optional; falls back to test-lab, never official-picks.
DISCORD_MANUAL_WEBHOOK=
# Legacy picks-only fallback. Prefer DISCORD_PICKS_WEBHOOK.
DISCORD_WEBHOOK_URL=
# Optional private #model-lab research webhook. Must not equal the official picks webhook.
DISCORD_MODEL_LAB_WEBHOOK=
# Optional: post "no qualifying plays" to official picks once per PT day (1/true/yes).
DISCORD_NO_PLAY_ENABLED=
# GitHub Actions uses signed OIDC from this repository workflow on main.
# Optional overrides: APP_URL and CRON_SECRET (must match Vercel).
# APP_URL=https://your-app.vercel.app
